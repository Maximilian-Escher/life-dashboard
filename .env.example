# Kopieren nach ".env" (nicht committen, siehe .gitignore) und mit echten
# Werten aus der Oura-Entwickler-App füllen: https://cloud.ouraring.com/oauth/applications
# "netlify dev" lädt diese Datei automatisch in die Functions.

OURA_CLIENT_ID=deine-oura-client-id
OURA_CLIENT_SECRET=dein-oura-client-secret

# Optional: nur nötig, falls die Redirect-URI von der lokalen abweicht
# (z.B. nach dem Deployment). Muss exakt mit der URI übereinstimmen, die in
# der Oura-Entwickler-App hinterlegt ist.
# OURA_REDIRECT_URI=http://localhost:8888/api/auth/oura/callback
